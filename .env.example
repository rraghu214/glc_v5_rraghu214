# Copy to .env and replace only the providers you use. Never commit .env.
GEMINI_API_KEY_1=replace-me
GEMINI_API_KEY_2=replace-me

# Logical provider order. Numbered Gemini slots are expanded automatically.
LLM_ORDER=ollama,gemini,nvidia,groq,cerebras,openrouter,github,unsloth_local
GLC_PORT=8111

# Unsloth Desktop, local, OpenAI-compatible (S18). UNSLOTH_BASE_URL has no
# default: Unsloth Desktop's llama-server binds an ephemeral port that isn't
# documented and can change across restarts. Find it with
# `netstat -ano | findstr LISTENING` cross-referenced against `tasklist` for
# llama-server.exe, then confirm with `curl <url>/v1/models`.
UNSLOTH_BASE_URL=http://127.0.0.1:55698/v1
UNSLOTH_API_KEY=sk-unsloth-local
UNSLOTH_MODEL=unsloth/Qwen3.5-9B-GGUF

# S16 channel bridge. Use the same private value in S16_CHANNEL_BRIDGE_TOKEN.
S16_BASE_URL=http://127.0.0.1:8113
GLC_S16_BRIDGE_TOKEN=replace-with-a-long-random-local-token
GLC_S16_TIMEOUT=180
